{
    "openapi": "3.0.1",
    "info": {
        "title": "Order Processing Management API",
        "description": "REST API for order management. Protected by OAuth2 (Keycloak via WSO2 gateway).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080/api",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Customers",
            "description": "Customer management. Requires scope customers:read or customers:write."
        },
        {
            "name": "Products",
            "description": "Product catalog management. Requires scope products:read or products:write."
        },
        {
            "name": "Orders",
            "description": "Order management. Requires scope orders:read or orders:write."
        }
    ],
    "paths": {
        "/products/{id}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get product by ID",
                "operationId": "getProductById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Product identifier",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "404": {
                        "description": "Product not found"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "200": {
                        "description": "Product found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "products:read"
                        ]
                    }
                ]
            },
            "put": {
                "tags": [
                    "Products"
                ],
                "summary": "Update product",
                "operationId": "updateProduct",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Product identifier",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductInput"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "404": {
                        "description": "Product not found"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "200": {
                        "description": "Product updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "products:write"
                        ]
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Products"
                ],
                "summary": "Delete product",
                "operationId": "deleteProduct",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Product identifier",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "404": {
                        "description": "Product not found"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "204": {
                        "description": "Product deleted successfully"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "products:write"
                        ]
                    }
                ]
            }
        },
        "/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "List all products",
                "operationId": "getAllProducts",
                "responses": {
                    "200": {
                        "description": "Product list returned successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Product"
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "products:read"
                        ]
                    }
                ]
            },
            "post": {
                "tags": [
                    "Products"
                ],
                "summary": "Create new product",
                "operationId": "createProduct",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductInput"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "201": {
                        "description": "Product created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "products:write"
                        ]
                    }
                ]
            }
        },
        "/orders": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "List all orders",
                "operationId": "getAllOrders",
                "responses": {
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "200": {
                        "description": "Order list returned successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Order"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "orders:read"
                        ]
                    }
                ]
            },
            "post": {
                "tags": [
                    "Orders"
                ],
                "summary": "Create new order",
                "operationId": "createOrder",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderInput"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "201": {
                        "description": "Order created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error or insufficient stock"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "orders:write"
                        ]
                    }
                ]
            }
        },
        "/customers": {
            "get": {
                "tags": [
                    "Customers"
                ],
                "summary": "List all customers",
                "operationId": "getAllCustomers",
                "responses": {
                    "401": {
                        "description": "Unauthorized"
                    },
                    "200": {
                        "description": "Customer list returned successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Customer"
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden — insufficient scope or not via gateway"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "customers:read"
                        ]
                    }
                ]
            },
            "post": {
                "tags": [
                    "Customers"
                ],
                "summary": "Create new customer",
                "operationId": "createCustomer",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CustomerInput"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "403": {
                        "description": "Forbidden"
                    },
                    "201": {
                        "description": "Customer created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Customer"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "400": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "customers:write"
                        ]
                    }
                ]
            }
        },
        "/orders/{id}/status": {
            "patch": {
                "tags": [
                    "Orders"
                ],
                "summary": "Update order status",
                "operationId": "updateOrderStatus",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Order identifier",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateOrderStatus"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Status updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid status value"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Order not found"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "orders:write"
                        ]
                    }
                ]
            }
        },
        "/orders/{id}": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Get order by ID",
                "operationId": "getOrderById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Order identifier",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "200": {
                        "description": "Order found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Order not found"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "orders:read"
                        ]
                    }
                ]
            }
        },
        "/orders/customer/{customerId}": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "List orders by customer",
                "operationId": "getOrdersByCustomer",
                "parameters": [
                    {
                        "name": "customerId",
                        "in": "path",
                        "description": "Customer identifier",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Customer not found"
                    },
                    "200": {
                        "description": "Orders list returned successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Order"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "orders:read"
                        ]
                    }
                ]
            }
        },
        "/customers/{id}": {
            "get": {
                "tags": [
                    "Customers"
                ],
                "summary": "Get customer by ID",
                "operationId": "getCustomerById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Customer identifier",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Customer found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Customer"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Customer not found"
                    }
                },
                "security": [
                    {
                        "keycloakOAuth2": [
                            "customers:read"
                        ]
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ProductInput": {
                "required": [
                    "name",
                    "price",
                    "stockQuantity"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Product name"
                    },
                    "description": {
                        "type": "string",
                        "description": "Product description"
                    },
                    "price": {
                        "type": "number",
                        "description": "Unit price"
                    },
                    "stockQuantity": {
                        "type": "integer",
                        "description": "Available stock quantity",
                        "format": "int32"
                    }
                },
                "description": "Payload to create or update a product"
            },
            "Product": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Product identifier",
                        "format": "int32"
                    },
                    "name": {
                        "type": "string",
                        "description": "Product name"
                    },
                    "description": {
                        "type": "string",
                        "description": "Product description"
                    },
                    "price": {
                        "type": "number",
                        "description": "Unit price"
                    },
                    "stockQuantity": {
                        "type": "integer",
                        "description": "Available stock quantity",
                        "format": "int32"
                    },
                    "createdAt": {
                        "type": "string",
                        "description": "Creation timestamp",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "description": "Last update timestamp",
                        "format": "date-time"
                    }
                },
                "description": "Product data"
            },
            "OrderInput": {
                "required": [
                    "customerId",
                    "items"
                ],
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "integer",
                        "description": "Customer identifier",
                        "format": "int32"
                    },
                    "items": {
                        "type": "array",
                        "description": "List of items in the order",
                        "items": {
                            "$ref": "#/components/schemas/OrderItemInput"
                        }
                    }
                },
                "description": "Payload to create an order"
            },
            "OrderItemInput": {
                "required": [
                    "productId",
                    "quantity"
                ],
                "type": "object",
                "properties": {
                    "productId": {
                        "type": "integer",
                        "description": "Product identifier",
                        "format": "int32"
                    },
                    "quantity": {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Quantity to order",
                        "format": "int32"
                    }
                },
                "description": "Item to add to an order"
            },
            "Order": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Order identifier",
                        "format": "int32"
                    },
                    "customerId": {
                        "type": "integer",
                        "description": "Customer identifier",
                        "format": "int32"
                    },
                    "customerName": {
                        "type": "string",
                        "description": "Customer name"
                    },
                    "status": {
                        "type": "string",
                        "description": "Order status",
                        "enum": [
                            "PENDING",
                            "CONFIRMED",
                            "PREPARING",
                            "SHIPPED",
                            "DELIVERED",
                            "CANCELLED"
                        ]
                    },
                    "totalAmount": {
                        "type": "number",
                        "description": "Total order amount"
                    },
                    "items": {
                        "type": "array",
                        "description": "Order items",
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        }
                    },
                    "createdAt": {
                        "type": "string",
                        "description": "Creation timestamp",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "description": "Last update timestamp",
                        "format": "date-time"
                    }
                },
                "description": "Order data"
            },
            "OrderItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Item identifier",
                        "format": "int32"
                    },
                    "productId": {
                        "type": "integer",
                        "description": "Product identifier",
                        "format": "int32"
                    },
                    "productName": {
                        "type": "string",
                        "description": "Product name at the time of the order"
                    },
                    "quantity": {
                        "type": "integer",
                        "description": "Quantity ordered",
                        "format": "int32"
                    },
                    "unitPrice": {
                        "type": "number",
                        "description": "Unit price at the time of the order"
                    },
                    "subtotal": {
                        "type": "number",
                        "description": "Subtotal for this item (quantity × unitPrice)"
                    }
                },
                "description": "Item within an order"
            },
            "CustomerInput": {
                "required": [
                    "cpf",
                    "email",
                    "name"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Full name"
                    },
                    "email": {
                        "type": "string",
                        "description": "Email address"
                    },
                    "cpf": {
                        "type": "string",
                        "description": "CPF document number"
                    }
                },
                "description": "Payload to create a customer"
            },
            "Customer": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Customer identifier",
                        "format": "int32"
                    },
                    "name": {
                        "type": "string",
                        "description": "Full name"
                    },
                    "email": {
                        "type": "string",
                        "description": "Email address"
                    },
                    "cpf": {
                        "type": "string",
                        "description": "CPF document number"
                    },
                    "createdAt": {
                        "type": "string",
                        "description": "Creation timestamp",
                        "format": "date-time"
                    }
                },
                "description": "Customer data"
            },
            "UpdateOrderStatus": {
                "required": [
                    "status"
                ],
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "New order status",
                        "enum": [
                            "PENDING",
                            "CONFIRMED",
                            "PREPARING",
                            "SHIPPED",
                            "DELIVERED",
                            "CANCELLED"
                        ]
                    }
                },
                "description": "Payload to update an order status"
            }
        }
    }
}