{
  "realm": "order-processing",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      { "name": "customers:read", "description": "Leitura de clientes" },
      { "name": "customers:write", "description": "Criação/edição de clientes" },
      { "name": "products:read", "description": "Leitura de produtos" },
      { "name": "products:write", "description": "Criação/edição/exclusão de produtos" },
      { "name": "orders:read", "description": "Leitura de pedidos" },
      { "name": "orders:write", "description": "Criação/edição de pedidos" },
      { "name": "mod:customers", "description": "Portal — pode abrir módulo Clientes" },
      { "name": "mod:products", "description": "Portal — pode abrir módulo Produtos" },
      { "name": "mod:orders", "description": "Portal — pode abrir módulo Pedidos" }
    ]
  },
  "groups": [
    {
      "name": "user",
      "path": "/user",
      "realmRoles": [
        "customers:read", "products:read", "orders:read",
        "mod:customers", "mod:products", "mod:orders"
      ],
      "attributes": { "description": ["Usuário com permissões de leitura"] }
    },
    {
      "name": "admin",
      "path": "/admin",
      "realmRoles": [
        "customers:read", "customers:write",
        "products:read", "products:write",
        "orders:read", "orders:write",
        "mod:customers", "mod:products", "mod:orders"
      ],
      "attributes": { "description": ["Administrador com todas as permissões"] }
    }
  ],
  "clientScopes": [
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${profileScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "given_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "lastName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "family_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${emailScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "default",
      "description": "Scope padrão exigido pelo WSO2 AccessTokenGenerator (OAUTH2_DEFAULT_SCOPE)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "order-processing-scopes",
      "description": "Scopes da API Order Processing (todos os módulos)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-to-scope",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "orders-module-scopes",
      "description": "Scopes apenas do módulo Orders",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-orders",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "products-module-scopes",
      "description": "Scopes apenas do módulo Products",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-products",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "customers-module-scopes",
      "description": "Scopes apenas do módulo Customers",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-customers",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "portal-module-scopes",
      "description": "Apenas escopos mod:* no token do portal (frontend)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-portal-mod",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["role_list", "profile", "email", "order-processing-scopes"],
  "clients": [
    {
      "clientId": "wso2-key-manager",
      "name": "WSO2 API Manager",
      "description": "Cliente para integração WSO2 validar tokens Keycloak",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "wso2-key-manager-secret-change-in-production",
      "redirectUris": ["https://localhost:9443/*", "https://localhost:8243/*"],
      "webOrigins": ["*"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["default", "openid", "roles", "role_list", "profile", "email", "order-processing-scopes"],
      "protocolMappers": [
        {
          "name": "realm-management-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "resource_access.realm-management.roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "realm-management"
          }
        }
      ]
    },
    {
      "clientId": "order-processing-portal",
      "name": "Order Processing Portal",
      "description": "SPA única (PKCE) — escopos mod:* vs API por client scopes opcionais",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4200/callback"
      ],
      "webOrigins": ["http://localhost:4200"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["default", "role_list", "profile", "email"],
      "optionalClientScopes": [
        "portal-module-scopes",
        "orders-module-scopes",
        "products-module-scopes",
        "customers-module-scopes"
      ]
    },
    {
      "clientId": "order-processing-api",
      "name": "Order Processing API",
      "description": "Cliente com todas as permissões (WSO2 + segundo passo OAuth silent)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "order-api-secret-change-in-production",
      "redirectUris": [
        "https://localhost:9443/*",
        "https://localhost:8243/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": ["*"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["role_list", "profile", "email", "order-processing-scopes"]
    }
  ]
}


