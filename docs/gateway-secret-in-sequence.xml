<sequence xmlns="http://ws.apache.org/ns/synapse" name="BackendSecurityInSequence">

    <!--
        ============================================================
        COMO USAR:
        Publisher → API → Runtime → Message Mediation
                 → In Flow → Upload este arquivo
        ============================================================

        Este sequence faz DUAS coisas:

        1. Injeta X-Gateway-Secret
           O backend valida este header para garantir que a requisição
           veio pelo WSO2 e não por acesso direto.

        2. Restaura o Authorization header
           O WSO2 remove o Bearer token original por padrão
           (remove_outbound_auth_header=true).
           O token fica salvo no contexto Synapse em 'api.ut.accessToken'
           e é reinjetado aqui para que o Spring Security possa validar o JWT.

        ============================================================
        IMPORTANTE: o value do X-Gateway-Secret DEVE ser igual ao
        configurado em application.yaml:
          wso2.gateway.validation.secret
          ou variável de ambiente GATEWAY_SECRET
        ============================================================
    -->

    <!-- 1. Header de autenticação do gateway -->
    <header name="X-Gateway-Secret"
            value="change-this-in-production-use-env-var"
            scope="transport"/>

    <!-- 2. Restaura o Bearer token (removido pelo WSO2 por padrão) -->
    <header name="Authorization"
            expression="fn:concat('Bearer ', get-property('api.ut.accessToken'))"
            scope="transport"/>

</sequence>
